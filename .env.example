# ─────────────────────────────────────────────────────────────
#  Lead Generation & Outreach Tool – Configuration Template
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Google Maps Places API ────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Database ──────────────────────────────────────────────────
DB_PATH=leads.db

# ── SMTP Email Credentials ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here   # Use an App Password for Gmail
SENDER_NAME=Your Name
SENDER_EMAIL=your_email@gmail.com

# ── SendGrid (optional – set USE_SENDGRID=true to enable) ─────
USE_SENDGRID=false
SENDGRID_API_KEY=

# ── Rate Limits ───────────────────────────────────────────────
MAX_EMAILS_PER_HOUR=10
REQUEST_DELAY_SECONDS=2.0
MAX_CRAWL_PAGES=3
REQUEST_TIMEOUT=10

# ── Email Template ────────────────────────────────────────────
EMAIL_SUBJECT=Improve your business online presence
# EMAIL_BODY_TEMPLATE supports {business_name} and {sender_name}
# Leave blank to use the built-in default template

# ── Scheduler ─────────────────────────────────────────────────
SCHEDULE_COLLECT_INTERVAL_HOURS=24
SCHEDULE_SEND_INTERVAL_HOURS=6

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=leadgen.log

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=your_secure_password_here
DASHBOARD_SECRET_KEY=generate-a-random-string-here
DASHBOARD_PORT=5000
